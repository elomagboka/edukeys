spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/edukeys
    username: edukeys
    password: edukeys
  jpa:
    hibernate:
      ddl-auto: validate
    open-in-view: false
  flyway:
    enabled: true
    locations: classpath:db/migration,classpath:db/testdata

edukeys:
  securite:
    jwt:
      # Valeur factice, 32 octets minimum : copier ce fichier en
      # application-local.yml (gitignoré) et la remplacer par un secret propre
      # à votre poste. Ne jamais réutiliser la valeur d'un autre profil.
      secret: remplacez-moi-par-un-secret-local-32-octets-minimum-svp
    journal:
      # Clé HMAC des empreintes du journal de sécurité et du limiteur de débit
      # (US-08a). Obligatoire : l'application refuse de démarrer sans elle.
      # Même règle que le secret JWT : 32 octets minimum, propre à votre poste.
      cle-empreinte: remplacez-moi-par-une-cle-locale-32-octets-minimum
